<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\CitizenSimulator.Items\CitizenSimulator.Items.csproj" />
      <ProjectReference Include="..\CitizenSimulator.Abstractions\CitizenSimulator.Abstractions.csproj" />
      <ProjectReference Include="..\CitizenSimulator.Property\CitizenSimulator.Property.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Business/**/*.json" />
        <EmbeddedResource Include="Recipes/**/*.json" />
    </ItemGroup>

    <Target Name="CopyModToHost"
            AfterTargets="Build">

        <PropertyGroup>
            <ModsDirectory>$(MSBuildProjectDirectory)/../CitizenSimulator/bin/$(Configuration)/$(TargetFramework)/Mods/</ModsDirectory>
        </PropertyGroup>

        <MakeDir Directories="$(ModsDirectory)/Core" />

        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(ModsDirectory)/Core"
                SkipUnchangedFiles="true" />

    </Target>
</Project>
