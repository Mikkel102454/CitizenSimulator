<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CitizenSimulator.CitizenMind</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\CitizenSimulator.Abstractions\CitizenSimulator.Abstractions.csproj" />
      <ProjectReference Include="..\CitizenSimulator.Calender\CitizenSimulator.Calender.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Data\" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="Data/**/*.yml" />
    </ItemGroup>
    
    <Target Name="CopyModToHost"
            AfterTargets="Build">

        <PropertyGroup>
            <ModsDirectory>$(MSBuildProjectDirectory)/../CitizenSimulator/bin/$(Configuration)/$(TargetFramework)/Mods/</ModsDirectory>
        </PropertyGroup>

        <MakeDir Directories="$(ModsDirectory)/Core" />

        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(ModsDirectory)/Core"
                SkipUnchangedFiles="true" />

    </Target>
</Project>
