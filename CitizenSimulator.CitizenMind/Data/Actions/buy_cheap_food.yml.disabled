id: test.buy_cheap_food
handler: test.purchase_cheap_food

parameters:
  price: 2
  portions: 1
  durationMinutes: 10

preconditions:
  - {fact: shops.cheap_available}
  - op: gte
    args:
      - {fact: finance.money}
      - {parameter: price}
  - op: lt
    args:
      - {fact: inventory.food_count}
      - {parameter: portions}

duration:
  unit: simulationMinutes
  estimate: {parameter: durationMinutes}

prediction:
  - fact: finance.money
    op: subtract
    value: {parameter: price}
  - fact: inventory.food_count
    op: add
    value: {parameter: portions}

completion:
  - op: gte
    args:
      - {fact: inventory.food_count}
      - {parameter: portions}

cost:
  expression:
    op: add
    args:
      - {calculated: durationMinutes}
      - {parameter: price}

execution:
  interruptible: true